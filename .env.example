# --- Docker build mirrors (CN / slow networks; optional overrides) ---
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Wheel download base for Docker harness build (uv.lock rewrite)
PYPI_MIRROR_PACKAGES=https://pypi.tuna.tsinghua.edu.cn/packages

# --- Server / API ---
OMA_API_KEY=dev-key
# Local dev: http://127.0.0.1:8787
# Remote Docker: must match the browser address bar Origin exactly
# (scheme + host + port, NO trailing slash). Example:
#   PUBLIC_BASE_URL=http://www.managed-agent.cloud:8787
# Mismatch → Better Auth logs: "Invalid origin: http://..."
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Public URL for webhooks/OAuth (defaults to PUBLIC_BASE_URL when unset).
# OMA_PUBLIC_URL=http://127.0.0.1:8787
# Public origin for the integrations gateway (OAuth redirect_uri + webhook
# URLs handed to Linear/GitHub/Slack). No trailing slash. When self-hosting
# behind a reverse proxy, set this to the externally-reachable URL.
# Defaults to PUBLIC_BASE_URL or http://127.0.0.1:8787.
# Same semantics as open-managed-agents GATEWAY_ORIGIN.
GATEWAY_ORIGIN=http://127.0.0.1:8787
# Extra Better Auth trusted origins (comma-separated). PUBLIC_BASE_URL is
# always trusted; use this when the browser may also hit IP or another host.
# TRUSTED_ORIGINS=http://124.221.28.203:8787,https://oma.example.com
TRUSTED_ORIGINS=
# Harness → platform callback base (schedule, MCP proxy). Docker Compose sets
# http://oma-platform:8787 automatically; local dev can omit this.
OMA_HARNESS_PLATFORM_BASE=http://127.0.0.1:8787

# --- Data storage ---
# Local dev: ./data/... (platform + harness share the host filesystem).
# Docker Compose overrides these to /data/... on the shared volume — do not
# change those compose values unless every path stays on ../data:/data.
# [SQLite] 原配置（已切换到 MySQL）
# DATABASE_PATH=./data/oma.db
# [MySQL] 新配置 — 支持多种格式：
#   URL:  mysql+aiomysql://managed:managedAgent123@124.221.28.203:3306/managed_agent
#   DSN:  managed:managedAgent123@tcp(124.221.28.203:3306)/managed_agent?parseTime=true&charset=utf8mb4
DATABASE_URL=mysql+aiomysql://managed:managedAgent123@124.221.28.203:3306/managed_agent
SANDBOX_WORKDIR=./data/sandboxes
SKILLS_DATA_DIR=./data/skills
FILES_DATA_DIR=./data/files
SESSION_OUTPUTS_DIR=./data/session-outputs
MEMORY_DATA_DIR=./data/memory
AUTH_DATABASE_PATH=./data/auth.db

# --- Sandbox (provider plugins; see ./start-litebox-sandbox.sh) ---
# Provider: local | litebox | boxlite | boxrun | e2b | daytona | opensandbox
#   local       — host workdir subprocess (default; same as open-managed-agents subprocess)
#   litebox     — BoxLite micro-VM (@boxlite-ai/boxlite); Apple Silicon macOS or Linux KVM
#   boxrun      — remote boxlite serve (BOXRUN_URL); for Intel Mac / k8s without KVM
#   e2b         — E2B Firecracker SaaS (E2B_API_KEY)
#   daytona     — Daytona cloud sandboxes (DAYTONA_API_KEY)
#   opensandbox — self-hosted OpenSandbox (Lifecycle Server + execd via server proxy)
SANDBOX_PROVIDER=opensandbox
# OCI image (litebox/boxrun/daytona) or E2B template id when provider=e2b
SANDBOX_IMAGE=node:22-slim

# LiteBox / BoxLite (embedded Node bridge: scripts/sandbox/litebox-bridge.mjs)
# Run once: ./scripts/sandbox/install-litebox.sh
#LITEBOX_MEMORY_MIB=512
#LITEBOX_CPUS=2
#LITEBOX_BRIDGE_PATH=./scripts/sandbox/litebox-bridge.mjs
#NODE_BIN=node

# BoxRun (boxlite serve on a KVM-capable host)
#BOXRUN_URL=http://127.0.0.1:8100/v1/default
#BOXRUN_TOKEN=
#BOXRUN_CPUS=2
#BOXRUN_MEMORY_MIB=512

# E2B
#E2B_API_KEY=
#E2B_API_BASE=https://api.e2b.app

# Daytona
#DAYTONA_API_KEY=
#DAYTONA_API_URL=https://app.daytona.io/api
#DAYTONA_TOOLBOX_PROXY=https://proxy.app.daytona.io/toolbox

# OpenSandbox (self-hosted; lifecycle server + per-sandbox execd)
# Lifecycle Server address (host:port). Required when SANDBOX_PROVIDER=opensandbox.
OPENSANDBOX_DOMAIN=127.0.0.1:18090
# "http" (default) or "https"
OPENSANDBOX_PROTOCOL=http
# OPEN-SANDBOX-API-KEY header; leave empty for INSECURE mode
OPENSANDBOX_API_KEY=
# Route execd traffic through the lifecycle server proxy (default true).
OPENSANDBOX_USE_SERVER_PROXY=true
# Container-internal execd port (default 44772)
OPENSANDBOX_EXECD_PORT=44772
# Container image; default python:3.12-slim (slim variant saves ~750MB;
# execd + shell + Python work fine; switch to python:3.12 if you need
# build toolchains inside the sandbox).
OPENSANDBOX_IMAGE=python:3.12-slim
# Optional entrypoint override; defaults to "tail -f /dev/null" (keep-alive)
# because the Lifecycle Server requires an entrypoint on every create.
OPENSANDBOX_ENTRYPOINT=
# Sandbox TTL in seconds (default 3600)
OPENSANDBOX_TIMEOUT_SECONDS=3600
# Resource limits (K8s-style strings)
OPENSANDBOX_CPU=500m
OPENSANDBOX_MEMORY=512Mi

# Workspace backup on session DELETE (T27); set 1 to disable tar snapshots
#OMA_WORKSPACE_BACKUP_DISABLED=0

# LiteBox smoke: skip (exit 0) on unsupported CPU e.g. Intel Mac
#LITEBOX_SMOKE_SKIP_UNSUPPORTED=1

# --- Harness (piPy sidecar) ---
# Local single harness: http://127.0.0.1:8090 (./start-harness.sh)
# Docker multi-replica: compose starts oma-harness-lb on host :8090 and sets
#   platform HARNESS_URL=http://oma-harness-lb:8090 (ignores this local value).
# Existing host Nginx on :80 (e.g. notebooklm-nginx) is unrelated — no clash.
# See docs/HARNESS_LOAD_BALANCING.md.
HARNESS_URL=http://127.0.0.1:8090
# Multi-replica (2+ oma-harness-* behind the LB) requires MySQL DATABASE_URL
# above — do not share one OMA_DATABASE_PATH SQLite across replicas.
# Optional per-replica LiteLLM virtual keys (with docker-compose.harness-keys.yml):
#HARNESS_LITELLM_KEY_1=
#HARNESS_LITELLM_KEY_2=
# 1 = in-process fake harness (no Python / no LLM); 0 = real harness
OMA_FAKE_HARNESS=0

# --- Managed harness: OpenClaw Gateway ---
# When both are set, agents with `_oma.harness: "managed"` and
# `runtime_binding.agent: "openclaw"` (or any known agent id) are routed to
# the OpenClaw Gateway over its OpenAI-compatible HTTP API.
# Leave OMA_OPENCLAW_GATEWAY_URL empty to fall back to the ManagedClient stub.
OMA_OPENCLAW_GATEWAY_URL=
OMA_OPENCLAW_TOKEN=
# Master switch for the OpenClaw harness. Set to 0/false/no/off to disable
# the backend (factory returns the stub client) and grey out the OpenClaw
# option in the Harness dropdown. Defaults to enabled when unset.
OMA_OPENCLAW_ENABLED=0

# --- Managed harness: Hermes Agent ---
# Hermes uses the OpenAI-compatible /v1/chat/completions endpoint but is
# stateless — the full conversation history is sent with every request.
# Default model id: hermes-agent.
OMA_HERMES_GATEWAY_URL=
OMA_HERMES_API_KEY=
# Master switch for the Hermes harness. Set to 0/false/no/off to disable
# the backend (factory returns the stub client) and grey out the Hermes
# option in the Harness dropdown. Defaults to enabled when unset.
OMA_HERMES_ENABLED=0

# --- Console UI ---
# Docker: baked into image (CONSOLE_DIR=/app/console). Local dev:
#   ./scripts/build-console.sh && CONSOLE_DIR=./console/dist
CONSOLE_DIR=./console/dist

# --- Authentication (better-auth sidecar) ---
# Docker Compose runs oma-auth in-stack; platform uses AUTH_UPSTREAM_URL below.
# Set AUTH_DISABLED=1 for local API-key-only dev (not production).
AUTH_DISABLED=0
AUTH_UPSTREAM_URL=http://127.0.0.1:8788
# Required in production — sessions break on restart if unset.
BETTER_AUTH_SECRET=
# Optional OAuth: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET

# --- LLM / model cards ---
# Fallback when agent.model has no matching model card (see GET /v1/model_cards)
ANTHROPIC_API_KEY=
# Shared secret for harness-side model credential fetch (x-internal-secret header)
# GET /v1/internal/model_cards/{id}/key?tenant_id=...
# GET /v1/internal/model_cards/resolve?tenant_id=...&model_id=...
OMA_INTERNAL_SECRET=dev-internal-secret
# piPy reads ~/.pi/agent/{settings,models,auth}.json when no model card key is set
OMA_DEFAULT_MODEL=qwen3.7-plus

# Optional Tavily override for web_search_tavily agents
TAVILY_API_KEY=

# --- Sessions ---
# POST /v1/sessions { "environment_id": "..." }
# Local dev: raise the per-tenant creation cap so back-to-back test runs don't 429.
OMA_RL_SESSIONS_TENANT=20

# --- Smoke test (./scripts/e2e/smoke-test.sh) ---
SMOKE_MODEL=qwen3.7-plus
# LLM + bash/uname tools, or SMOKE_SKIP_LLM=1 (P1+P2 APIs only, no harness)
# Optional: SMOKE_SKIP_P2=1 (skip skills/vault/console stubs)
# Console integration: ./scripts/e2e/console-integration.sh
#   UI dogfood: cd scripts && npm install && node console-dogfood.mjs
#   Uses cached Playwright shell if npx playwright install chromium is slow
# Optional: SMOKE_SKIP_TOOLS=1 SMOKE_TOOLS_ONLY=1 SMOKE_TOOL_TIMEOUT_SEC=180
# Optional: SMOKE_MODEL_CARD_ID=smoke-claude SMOKE_MODEL=claude-sonnet-4-6

# Web tools API keys (for China deployment)
JINA_API_KEY=

# Agent built-in memory (Hermes parity) — see docs/design/memory/agent-memory.md
OMA_MEMORY_ENABLED=1
