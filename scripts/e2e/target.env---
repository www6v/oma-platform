# Copy to target.env to point E2E scripts at a remote stack.
# Local is the default — no file needed when testing 127.0.0.1.
#
#   cp scripts/e2e/target.env.example scripts/e2e/target.env

# Platform / Console API (oma-server)
PLATFORM_URL=http://124.221.28.203:8787
CONSOLE_URL=http://124.221.28.203:8787
OMA_BASE_URL=http://124.221.28.203:8787
OMA_API_URL=http://124.221.28.203:8787

# Harness sidecar
HARNESS_URL=http://124.221.28.203:8090

# Set if the remote stack uses a different API key than local .env
# OMA_API_KEY=your-remote-key
