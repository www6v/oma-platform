# syntax=docker/dockerfile:1

ARG REGISTRY_MIRROR=
FROM ${REGISTRY_MIRROR:+${REGISTRY_MIRROR}/}node:22-bookworm-slim
ARG APT_MIRROR=mirrors.aliyun.com
ARG NPM_REGISTRY=https://registry.npmmirror.com

RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY auth-sidecar/package.json auth-sidecar/package-lock.json ./
RUN npm config set registry "${NPM_REGISTRY}" \
  && npm ci --omit=dev

COPY auth-sidecar/server.mjs ./

ENV AUTH_LISTEN_ADDR=0.0.0.0:8788
EXPOSE 8788
CMD ["node", "server.mjs"]
