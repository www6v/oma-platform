# syntax=docker/dockerfile:1

FROM python:3.12-slim

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# OpenViking context database (external memory provider for piPy-hermes-memory).
RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" openviking==0.4.13

EXPOSE 1933

CMD ["openviking-server", "--config", "/etc/openviking/ov.conf", "--host", "0.0.0.0", "--port", "1933"]
