# syntax=docker/dockerfile:1

ARG REGISTRY_MIRROR=
FROM ${REGISTRY_MIRROR:+${REGISTRY_MIRROR}/}python:3.12-slim

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# OpenViking context database (external memory provider for piPy-hermes-memory).
RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" openviking==0.4.13

# Web Studio overlay: lets deep links assert a tenant identity so tenant
# memories (viking://user/<tenant>/...) are visible in the Studio tree.
COPY deploy/openviking/openviking-studio-inject.js /opt/oma/openviking-studio-inject.js
COPY deploy/openviking/docker-entrypoint-openviking.sh /opt/oma/entrypoint.sh
RUN chmod +x /opt/oma/entrypoint.sh

EXPOSE 1933

ENTRYPOINT ["/opt/oma/entrypoint.sh"]
CMD ["openviking-server", "--config", "/etc/openviking/ov.conf", "--host", "0.0.0.0", "--port", "1933"]
